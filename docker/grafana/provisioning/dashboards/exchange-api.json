{
  "uid": "healthcare-exchange-api",
  "title": "Healthcare Exchange API",
  "tags": ["healthcare", "exchange", "devops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "15s",
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Duration p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hde_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [
        {
          "expr": "sum(rate(hde_http_request_duration_seconds_count[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Patient Registrations",
      "targets": [
        {
          "expr": "sum(rate(hde_patient_registrations_total[5m])) by (org_type, consent_status)",
          "legendFormat": "{{org_type}} / {{consent_status}}"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Record Publications",
      "targets": [
        {
          "expr": "sum(rate(hde_record_publications_total[5m])) by (record_type)",
          "legendFormat": "{{record_type}}"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auth Failures",
      "targets": [
        {
          "expr": "sum(rate(hde_auth_failures_total[5m])) by (auth_flow, reason)",
          "legendFormat": "{{auth_flow}} / {{reason}}"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Document Upload Attempts",
      "targets": [
        {
          "expr": "sum(rate(hde_document_uploads_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Registrations 24h",
      "targets": [
        {
          "expr": "sum(increase(hde_patient_registrations_total[24h]))",
          "legendFormat": "registrations"
        }
      ],
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 6 }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Records Published 24h",
      "targets": [
        {
          "expr": "sum(increase(hde_record_publications_total[24h]))",
          "legendFormat": "records"
        }
      ],
      "gridPos": { "x": 6, "y": 24, "w": 6, "h": 6 }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Auth Failures 24h",
      "targets": [
        {
          "expr": "sum(increase(hde_auth_failures_total[24h]))",
          "legendFormat": "failures"
        }
      ],
      "gridPos": { "x": 12, "y": 24, "w": 6, "h": 6 }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Uploads 24h",
      "targets": [
        {
          "expr": "sum(increase(hde_document_uploads_total[24h]))",
          "legendFormat": "uploads"
        }
      ],
      "gridPos": { "x": 18, "y": 24, "w": 6, "h": 6 }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "API Target",
      "targets": [
        {
          "expr": "up{job=\"exchange-api\"}",
          "legendFormat": "exchange-api"
        }
      ],
      "gridPos": { "x": 0, "y": 30, "w": 6, "h": 6 }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Jenkins Target",
      "targets": [
        {
          "expr": "up{job=\"jenkins\"}",
          "legendFormat": "jenkins"
        }
      ],
      "gridPos": { "x": 6, "y": 30, "w": 6, "h": 6 }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Jenkins Executors Online",
      "targets": [
        {
          "expr": "sum(default_jenkins_executors_online)",
          "legendFormat": "executors"
        }
      ],
      "gridPos": { "x": 12, "y": 30, "w": 6, "h": 6 }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Jenkins Queue",
      "targets": [
        {
          "expr": "sum(default_jenkins_executors_queue_length)",
          "legendFormat": "queued"
        }
      ],
      "gridPos": { "x": 18, "y": 30, "w": 6, "h": 6 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "API Process Memory",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"exchange-api\"}",
          "legendFormat": "rss"
        },
        {
          "expr": "nodejs_heap_size_used_bytes{job=\"exchange-api\"}",
          "legendFormat": "heap used"
        }
      ],
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Jenkins Jobs And Runs",
      "targets": [
        {
          "expr": "jenkins_job_count_value",
          "legendFormat": "jobs"
        },
        {
          "expr": "increase(jenkins_runs_success_total[1h])",
          "legendFormat": "successful runs 1h"
        },
        {
          "expr": "increase(jenkins_runs_failure_total[1h])",
          "legendFormat": "failed runs 1h"
        }
      ],
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 }
    }
  ]
}
